# The Electron desktop launcher sets DATABASE_URL, DATABASE_SQLITE_STORAGE_DIR,
# and DB_ENCRYPTION_KEY automatically using Electron's user data directory.
# These overrides are for standalone local development only.
# DATABASE_URL="file:./.data/placedv.sqlite"
# DATABASE_SQLITE_STORAGE_DIR=".data/sqlite"
# DB_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"
# DATABASE_AUDIT_RETENTION_DAYS="90"

# Optional usage analytics for the app. The project key is public by design.
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
