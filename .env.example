# MySQL database used by Placedv Query itself.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/placedv_query"

# NextAuth and GitHub OAuth. Add the local callback URL to your GitHub OAuth app:
# http://localhost:3000/api/auth/callback/github
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 32-byte hexadecimal key. Keep this value stable and back it up securely.
DB_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"
# Optional key rotation. Keep every old key until all data encrypted with it has been rotated.
# DB_ENCRYPTION_KEYS='{"legacy":"<old-64-character-hex-key>","key-2026-10":"<new-64-character-hex-key>"}'
# DB_ENCRYPTION_CURRENT_KEY_ID="key-2026-10"

# Optional local configuration.
DATABASE_SQLITE_STORAGE_DIR=".data/sqlite"
DATABASE_AUDIT_RETENTION_DAYS="90"
# DATABASE_PRIVATE_HOST_ALLOWLIST="db.internal,192.168.1.10"
# DATABASE_SSL_CA_PEM="-----BEGIN CERTIFICATE-----..."
# DATABASE_AUDIT_CLEANUP_SECRET=""
