generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The desktop app has one local profile and no remote account system.
model User {
  id              String             @id @default(cuid())
  name            String?
  email           String?            @unique
  admin           Boolean            @default(false)
  token           String?
  Database        Database[]
  DatabaseAuditLog DatabaseAuditLog[]
  LegalAcceptance LegalAcceptance[]
}

model Database {
  id                         String   @id @default(cuid())
  user_id                    String
  db_name                    String
  db_url_connection          String
  preferences                String?
  authorizationConfirmedAt   DateTime?
  authorizationVersion       String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now())
  user                       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model LegalAcceptance {
  id              String   @id @default(cuid())
  userId          String
  documentType    String
  documentVersion String
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentVersion])
  @@index([userId, acceptedAt])
}

model DatabaseAuditLog {
  id            String   @id @default(cuid())
  user_id       String
  database_id   String
  database_name String
  action        String
  query         String?
  table_name    String?
  affected_rows Int?
  status        String   @default("started")
  error_code    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, createdAt])
  @@index([user_id, database_id, createdAt])
  @@index([database_id, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ExternalConnectionLease {
  slot_id     Int       @id
  lease_token String?
  expires_at  DateTime?

  @@index([expires_at])
}
