generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  admin         Boolean    @default(false)
  token         String?
  is2FAEnabled  Boolean    @default(false)
  is2FAActive   Boolean    @default(false)
  twoFASecret   String?    @db.LongText
  twoFAPendingSecret String? @db.LongText
  twoFAPendingExpiresAt DateTime? @db.DateTime(3)
  twoFAFailedAttempts Int @default(0)
  twoFALockedUntil DateTime? @db.DateTime(3)
  twoFALastVerifiedStep BigInt?
  Account       Account[]
  Database      Database[]
  DatabaseAuditLog DatabaseAuditLog[]
  LegalAcceptance LegalAcceptance[]
}

model Database {
  id                String   @id @default(cuid())
  user_id           String
  db_name           String
  db_url_connection String   @db.LongText
  preferences       Json?
  authorizationConfirmedAt DateTime? @db.DateTime(3)
  authorizationVersion String? @db.VarChar(32)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model LegalAcceptance {
  id              String   @id @default(cuid())
  userId          String
  documentType    String   @db.VarChar(32)
  documentVersion String   @db.VarChar(32)
  acceptedAt      DateTime @default(now()) @db.DateTime(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentVersion])
  @@index([userId, acceptedAt])
}

model DatabaseAuditLog {
  id            String   @id @default(cuid())
  user_id       String
  database_id   String
  database_name String
  action        String
  query         String?  @db.LongText
  table_name    String?
  affected_rows Int?
  status        String   @default("started")
  error_code    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, createdAt])
  @@index([user_id, database_id, createdAt])
  @@index([database_id, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ExternalConnectionLease {
  slot_id    Int       @id
  lease_token String?  @db.VarChar(191)
  expires_at DateTime? @db.DateTime(3)

  @@index([expires_at])
}

model TwoFactorIpAttempt {
  ipHash          String    @id @db.VarChar(64)
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @db.DateTime(3)
  lockedUntil     DateTime? @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)

  @@index([lockedUntil])
  @@index([updatedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
